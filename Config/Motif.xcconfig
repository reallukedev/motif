// Shared build configuration for every target.
//
// To build your own copy, don't edit this file. Copy Local.example.xcconfig to
// Local.xcconfig (gitignored) and set your team and bundle identifier there. It's
// included at the end, so its values win.

// ── The maintainer's signing identity ───────────────────────────────────────────
// Committed so the published app builds from a clean checkout. Team IDs aren't secret;
// every signed binary contains one.
DEVELOPMENT_TEAM = W3Y3Z7CJH2

// Don't change it once the app ships: the App Group holding the history, the iCloud
// container, the Last.fm sign-in in the Keychain, the widgets and the MusicKit service are
// all keyed to it. A new identifier would be a new app with none of that data.
MOTIF_BUNDLE_ID = com.luke.motif
// ────────────────────────────────────────────────────────────────────────────────

// The version people see, and the build number App Store Connect requires to go up with
// every upload. Both Info.plists read these.
MARKETING_VERSION = 1.0
CURRENT_PROJECT_VERSION = 1

// App Group identifiers differ by platform: iOS uses `group.<name>`, macOS needs the team
// ID prefix. An App Group only shares data between an app and its extensions on one
// device; cross-device sync is the CloudKit container below.
MOTIF_APP_GROUP[sdk=iphoneos*]         = group.$(MOTIF_BUNDLE_ID)
MOTIF_APP_GROUP[sdk=iphonesimulator*]  = group.$(MOTIF_BUNDLE_ID)
MOTIF_APP_GROUP[sdk=macosx*]           = $(DEVELOPMENT_TEAM).group.$(MOTIF_BUNDLE_ID)

// The CloudKit container for sync, the same on both platforms. Automatic signing creates
// it on the first build, which needs `-allowProvisioningUpdates` (build.sh passes it).
MOTIF_ICLOUD_CONTAINER = iCloud.$(MOTIF_BUNDLE_ID)

// Last.fm credentials identify the application, not the user. Register one at
// https://www.last.fm/api/account/create.
//
// Leave these empty, since this file is committed. Put real values in
// Config/Secrets.xcconfig (gitignored), starting from Secrets.example.xcconfig. Without
// them the app still runs and reports that Last.fm isn't set up.
MOTIF_LASTFM_API_KEY =
MOTIF_LASTFM_SECRET =

SWIFT_VERSION = 6.0
SWIFT_APPROACHABLE_CONCURRENCY = YES
SWIFT_STRICT_CONCURRENCY = complete

IPHONEOS_DEPLOYMENT_TARGET = 27.0
MACOSX_DEPLOYMENT_TARGET = 27.0

CODE_SIGN_STYLE = Automatic

// Optional, and last so they override the values above. A fresh clone builds for the
// simulator and as an unsigned Mac app without either.
#include? "Local.xcconfig"
#include? "Secrets.xcconfig"
