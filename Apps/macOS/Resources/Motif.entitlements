<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>com.apple.security.app-sandbox</key>
    <true/>

    <key>com.apple.security.application-groups</key>
    <array>
        <string>$(MOTIF_APP_GROUP)</string>
    </array>

    <!-- MusicKit in a sandboxed Mac app. There is no `com.apple.developer.music-kit`. -->
    <key>com.apple.security.personal-information.media-library</key>
    <true/>

    <!-- The hardened runtime / TCC check for sending Apple events. The sandbox check
         below is separate, and both must pass. -->
    <key>com.apple.security.automation.apple-events</key>
    <true/>

    <!-- The sandbox check for Apple events. Used instead of
         `com.apple.security.temporary-exception.apple-events`, which the Mac App Store
         rejects. Music and Spotify declare these access groups in their scripting
         dictionaries. `com.apple.Music.playback` covers transport, `current track`,
         `current stream title` and `current stream URL`; `library.read` is only for artwork.

         The sandbox check runs before TCC, so a misspelled access group gives no prompt,
         only -1743, which looks exactly like the user saying no. -->
    <key>com.apple.security.scripting-targets</key>
    <dict>
        <key>com.apple.Music</key>
        <array>
            <string>com.apple.Music.playback</string>
            <string>com.apple.Music.library.read</string>
        </array>
        <key>com.spotify.client</key>
        <array>
            <string>com.spotify.playback</string>
            <string>com.spotify.library</string>
        </array>
    </dict>

    <key>com.apple.security.network.client</key>
    <true/>

    <!-- iCloud sync, which is also the backup. Automatic signing creates the container on
         the first build; see Config/Motif.xcconfig. -->
    <key>com.apple.developer.icloud-container-identifiers</key>
    <array>
        <string>$(MOTIF_ICLOUD_CONTAINER)</string>
    </array>
    <key>com.apple.developer.icloud-services</key>
    <array>
        <string>CloudKit</string>
    </array>
</dict>
</plist>
