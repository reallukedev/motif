<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>com.apple.security.application-groups</key>
    <array>
        <string>$(MOTIF_APP_GROUP)</string>
    </array>

    <!-- iCloud sync, which is also the backup. Automatic signing creates the container on
         the first build; see Config/Motif.xcconfig. -->
    <key>com.apple.developer.icloud-container-identifiers</key>
    <array>
        <string>$(MOTIF_ICLOUD_CONTAINER)</string>
    </array>
    <key>com.apple.developer.icloud-services</key>
    <array>
        <string>CloudKit</string>
    </array>

    <!-- CloudKit tells the mirror about another device's changes with a silent push. Without
         this the store only fetches when it opens, so a change made on the Mac doesn't reach
         an iPhone that's already running. Signing switches it to production for
         distribution. -->
    <key>aps-environment</key>
    <string>development</string>

    <!-- Settings and song statuses ride in iCloud's key-value store rather than the CloudKit
         container, because widgets and intents read them straight out of the App Group's
         defaults without opening the model container. See MotifCore's SettingsSync.

         Both apps resolve this to the same string — they share a bundle id — which is what
         lets the Mac and the iPhone see each other's settings. Without the entitlement
         NSUbiquitousKeyValueStore accepts writes and syncs nothing. -->
    <!-- Siri's "play" requests, which Motif handles in the app. Automatic signing adds the
         capability to the App ID. -->
    <key>com.apple.developer.siri</key>
    <true/>

    <key>com.apple.developer.ubiquity-kvstore-identifier</key>
    <string>$(TeamIdentifierPrefix)$(CFBundleIdentifier)</string>

    <!-- CarPlay's audio apps. Apple grants it on request, and has for Motif's App ID. Keep
         everything else here the same as Motif.entitlements, which a copy built without
         the grant uses instead; see MOTIF_IOS_ENTITLEMENTS in Config/Motif.xcconfig. -->
    <key>com.apple.developer.carplay-audio</key>
    <true/>
</dict>
</plist>
